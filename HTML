<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>לוח הופעות ואירועים - קריית התרבות אונו</title>
    <!-- Tailwind CSS לעיצוב מהיר ויפה -->
    <script src="https://jsdelivr.net"></script>
    <style>
        @import url('https://googleapis.com');
        body { font-family: 'Heebo', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen pb-12">

    <!-- סרגל עליון -->
    <header class="bg-gradient-to-r from-purple-700 to-indigo-800 text-white py-6 shadow-md mb-8 text-center">
        <h1 class="text-3xl font-bold">לוח הופעות ואירועים בזמן אמת</h1>
        <p class="text-purple-200 mt-2 text-sm">מתעדכן אוטומטית מתוך אתר קריית התרבות אונו</p>
    </header>

    <!-- אזור התוכן הראשי -->
    <main class="max-w-6xl mx-auto px-4">
        
        <!-- הודעת טעינה -->
        <div id="loader" class="text-center py-12">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-4 border-b-4 border-indigo-600 mb-4"></div>
            <p class="text-gray-500 text-lg">שואב את ההופעות החמות ביותר...</p>
        </div>

        <!-- הודעת שגיאה במקרה הצורך -->
        <div id="error-msg" class="hidden bg-red-50 border-r-4 border-red-500 p-4 text-red-700 mb-6 rounded shadow-sm text-center">
            חלקה שגיאה בטעינת הנתונים. נסו לרענן את הדף.
        </div>

        <!-- גריד כרטיסיות ההופעות -->
        <div id="events-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- כאן יוזרקו ההופעות באמצעות ה-JS -->
        </div>
    </main>

    <script>
        async function fetchEvents() {
            const targetUrl = 'https://tarbutono.co.il';
            // שימוש בפרוקסי חינמי לעקיפת חסימת CORS בדפדפן
            const proxyUrl = `https://allorigins.win{encodeURIComponent(targetUrl)}`;

            try {
                const response = await fetch(proxyUrl);
                if (!response.ok) throw new Error('Network response was not ok.');
                
                const data = await response.json();
                
                // יצירת אלמנט וירטואלי כדי לנתח את ה-HTML שחזר
                const parser = new DOMParser();
                const doc = parser.parseFromString(data.contents, 'text/html');
                
                // מציאת כל קוביות/שורות האירועים (מבוסס על המבנה הטיפוסי של האתר)
                // הערה: אם האתר ישנה משמעותית את מבנה הקוד שלו, יהיה צורך לעדכן את ה-Selectors כאן
                const eventElements = doc.querySelectorAll('.event-item, .events-list-item, article'); 
                
                const container = document.getElementById('events-container');
                document.getElementById('loader').classList.add('hidden');

                if (eventElements.length === 0) {
                    // ניסיון גיבוי אם הסלקטורים הרגילים לא עבדו (תצוגת טבלה חלופית)
                    showFallbackData();
                    return;
                }

                eventElements.forEach(el => {
                    // שליפת נתונים מתוך המבנה (דוגמה גנרית מותאמת לאתרי וורדפרס/אירועים)
                    const title = el.querySelector('h2, .title, .event-title')?.innerText.trim() || 'מופע ללא שם';
                    const date = el.querySelector('.date, .event-date, time')?.innerText.trim() || 'טרם נקבע תאריך';
                    const time = el.querySelector('.time, .event-time')?.innerText.trim() || '';
                    const location = el.querySelector('.location, .venue')?.innerText.trim() || 'קריית התרבות אונו';
                    const link = el.querySelector('a')?.href || targetUrl;
                    
                    // בניית כרטיס מעוצב לכל הופעה
                    const card = document.createElement('div');
                    card.className = "bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-gray-100 flex flex-col justify-between";
                    
                    card.innerHTML = `
                        <div class="p-6">
                            <span class="inline-block bg-indigo-50 text-indigo-700 text-xs px-2.5 py-1 rounded-full font-bold mb-3">${location}</span>
                            <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight">${title}</h3>
                            <div class="text-sm text-gray-600 space-y-1 mt-4">
                                <p class="flex items-center"><span class="ml-2">📅</span> <strong>תאריך:</strong> ${date}</p>
                                ${time ? `<p class="flex items-center"><span class="ml-2">🕒</span> <strong>שעה:</strong> \${time}</p>` : ''}
                            </div>
                        </div>
                        <div class="p-6 pt-0">
                            <a href="${link}" target="_blank" class="block w-full text-center bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-lg transition-colors duration-200">
                                פרטים והזמנת כרטיסים ←
                            </a>
                        </div>
                    `;
                    container.appendChild(card);
                });

            } catch (error) {
                console.error('Error fetching data:', error);
                document.getElementById('loader').classList.add('hidden');
                document.getElementById('error-msg').classList.remove('hidden');
                showFallbackData(); // הצגת פתרון גיבוי ידני/הסבר אם הפרוקסי נכשל
            }
        }

        function showFallbackData() {
            // פונקציית גיבוי שמציגה הודעה ברורה או iframe במקרה שהאתר חסם לחלוטין קריאות שרת
            const container = document.getElementById('events-container');
            container.className = "w-full text-center py-6";
            container.innerHTML = `
                <div class="bg-yellow-50 border-r-4 border-yellow-500 p-6 rounded-lg text-right max-w-2xl mx-auto shadow-sm">
                    <h3 class="text-lg font-bold text-yellow-800 mb-2">אבטחת האתר המקורי מונעת משיכה ישירה</h3>
                    <p class="text-gray-700 mb-4">כדי לעקוף זאת ולראות את העיצוב המלא בכל רגע, מומלץ להשתמש בתוסף דפדפן או לפתוח את העמוד ישירות:</p>
                    <a href="https://tarbutono.co.il" target="_blank" class="inline-block bg-yellow-600 text-white px-4 py-2 rounded font-medium hover:bg-yellow-700">לחצו כאן למעבר ישיר לאתר ההופעות</a>
                </div>
            `;
        }

        // הפעלה בטעינת הדף
        window.addEventListener('DOMContentLoaded', fetchEvents);
    </script>
</body>
</html>
